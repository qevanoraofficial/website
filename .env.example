# Secret sesi order website, minimal 32 karakter acak
ORDER_SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# Secret khusus WebTools Admin, minimal 24 karakter.
# Nilainya WAJIB sama dengan DIGIE_STORE_API_SECRET pada project WebTools.
WEBTOOLS_API_SECRET=GANTI_DENGAN_SECRET_WEBTOOLS_MINIMAL_24_KARAKTER

# GitHub Fine-grained Personal Access Token.
# Repository permission: Contents = Read and write.
GITHUB_TOKEN=github_pat_ISI_TOKEN_GITHUB
GITHUB_OWNER=digiestore
GITHUB_REPO=Digiestore
GITHUB_BRANCH=main

# Path penyimpanan data dalam repository
PRODUCTS_FILE=src/data/products.json
TESTIMONIALS_FILE=src/data/testimonials.json
ORDERS_FILE=src/data/orders.json

# Supabase QEVANORA (publishable; aman untuk frontend)
NEXT_PUBLIC_SUPABASE_URL=https://oxepyegsbndowlbdzfes.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_L16mPnB-bY0SogkuEmcxFQ_RtIVYBPf

# HANYA backend/Vercel. Jangan pernah diawali NEXT_PUBLIC_.
# Supabase > Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_GANTI_DENGAN_SECRET_KEY_PROJECT

# Komerce / RajaOngkir Payment API
# Mulai dengan sandbox. Ubah ke true hanya setelah Live Mode Payment API disetujui.
# API key dan kode channel diambil dari Collaborator Dashboard / endpoint payment methods.
KOMERCE_PAYMENT_API_KEY=GANTI_DENGAN_PAYMENT_API_KEY
KOMERCE_PAYMENT_IS_PRODUCTION=false
KOMERCE_PAYMENT_TYPE=qris
KOMERCE_PAYMENT_CHANNEL_CODE=GANTI_DENGAN_KODE_CHANNEL_QRIS_DARI_METHODS
# Secret buatan sendiri untuk menandatangani callback. Gunakan minimal 32 karakter acak.
KOMERCE_CALLBACK_API_KEY=GANTI_DENGAN_SECRET_CALLBACK_ACAK_MINIMAL_32_KARAKTER

# Legacy Midtrans
# Pertahankan sementara jika masih ada transaksi Midtrans lama yang pending.
# Tidak digunakan lagi untuk membuat top up baru.
MIDTRANS_SERVER_KEY=Mid-server-GANTI_DENGAN_SERVER_KEY_PRODUCTION
MIDTRANS_IS_PRODUCTION=true

# Follow.co.id supplier API
FOLLOW_API_URL=https://follow.co.id/api/v2
FOLLOW_API_KEY=
# AUTO = baca currency dari endpoint balance Follow.co.id.
# Jika provider tidak mengirim currency, set manual ke IDR atau USD.
# Sistem sengaja TIDAK menebak mata uang agar harga jual tidak salah.
FOLLOW_RATE_CURRENCY=AUTO
# Hanya dipakai bila rate provider ber-currency USD.
FOLLOW_USD_IDR_RATE=17000
# Margin harga jual di atas rate provider. Contoh 20 = tambah 20%.
FOLLOW_MARKUP_PERCENT=0

# Nokos virtual number API (backend only)
NOKOS_API_URL=https://nokos.co.id/api/
NOKOS_API_KEY=
# Margin harga jual QEVANORA di atas harga supplier. Contoh 20 = +20%.
NOKOS_MARKUP_PERCENT=0
# Tambahan nominal tetap per nomor. Contoh 500 = +Rp500.
NOKOS_MARKUP_FLAT=0
